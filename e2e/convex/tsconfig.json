{
  "compilerOptions": {
    "allowJs": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "target": "ESNext",
    "lib": ["ES2023", "dom"],
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "./**/*",
    "../audit/**/*.ts",
    "../oauth-provider/**/*.ts",
    "../browser-surfaces/**/*.ts",
    "../adapter/**/*.ts"
  ],
  "exclude": ["./_generated"]
}
