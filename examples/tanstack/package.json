{
  "name": "convex-better-auth-tanstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "run-p -r 'dev:*'",
    "dev:frontend": "vite dev --port 3000",
    "dev:backend": "convex dev --typecheck-components",
    "dev:build": "chokidar '../../tsconfig*.json' '../../src/**/*.ts' '../../src/**/*.tsx' -i '**/*.test.ts' -c 'npm run build' --initial",
    "predev": "convex dev --skip-push && mkdir -p dist",
    "build": "convex codegen --component-dir ../../src/component && cd ../../ && npm run build",
    "lint": "prettier --check '**/*' --ignore-unknown && eslint --ext .ts,.tsx ./app",
    "format": "prettier --write '**/*' --ignore-unknown"
  },
  "dependencies": {
    "@convex-dev/better-auth": "file:../..",
    "@convex-dev/react-query": "0.0.0-alpha.8",
    "@convex-dev/resend": "^0.2.5",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@react-email/components": "^1.0.12",
    "@tailwindcss/postcss": "^4.1.8",
    "@tanstack/react-form": "^1.25.0",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-router": "^1.140.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "better-auth": "file:../../node_modules/better-auth",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "file:../../node_modules/convex",
    "dotenv": "^16.5.0",
    "http-proxy-middleware": "^3.0.5",
    "lucide-react": "^0.513.0",
    "postcss": "^8.5.4",
    "react": "file:../../node_modules/react",
    "react-dom": "file:../../node_modules/react-dom",
    "react-qr-code": "^2.0.18",
    "redaxios": "^0.5.1",
    "resend": "^4.2.0",
    "sonner": "^2.0.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "~8.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "3.4.2",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.7.2",
    "vite": "^7.2.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
